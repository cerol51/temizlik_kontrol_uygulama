# ------------------------------------------------------------------------------
# Veritabanı (PostgreSQL) Konfigürasyonu
# ------------------------------------------------------------------------------
POSTGRES_USER=wc_cleaning
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=wc_cleaning
DATABASE_URL=postgres://wc_cleaning:change-this-password@localhost:5432/wc_cleaning

# Veritabanı Bağlantı Havuzu (SRE)
DB_POOL_MAX=20
DB_POOL_MIN=4
TYPEORM_SYNCHRONIZE=false

# ------------------------------------------------------------------------------
# API Sunucu & Güvenlik
# ------------------------------------------------------------------------------
NODE_ENV=production
API_PORT=3000
# En az 32 karakterlik güçlü rastgele anahtar
APP_JWT_SECRET=degistiriniz_en_az_32_karakterli_guclu_jwt_anahtari_12345
CORS_ORIGIN=http://localhost:5173,http://localhost:80,http://localhost
TRUST_PROXY=false

# ------------------------------------------------------------------------------
# Web Push (VAPID) Bildirimleri (İsteğe Bağlı)
# ------------------------------------------------------------------------------
VAPID_SUBJECT=mailto:ops@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# Keycloak SSO / OIDC (İsteğe Bağlı Kurumsal Kimlik Sağlayıcı)
# ------------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-this-admin-password
OIDC_ISSUER=http://localhost:8080/realms/wc-cleaning
